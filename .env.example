# No required environment variables for basic tool execution.
# The contact form uses the built-in Google Apps Script endpoint and tools run locally in the browser.

# ==============================================================================
# Optional: Codepackr Admin Portal & Tool Governance (Firebase Authentication & Firestore)
# ==============================================================================
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID_HERE
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID_HERE
VITE_FIREBASE_MEASUREMENT_ID=G-YOUR_MEASUREMENT_ID_HERE
VITE_FIREBASE_AUTH_ACTION_URL=https://www.codepackr.com/admin/auth-action
VITE_ADMIN_PORTAL_ROUTE=/admin-console

