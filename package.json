{
  "name": "codepackr",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "node scripts/generate-icons.mjs && node scripts/build-sitemap.mjs && node scripts/generate-metadata.mjs && node scripts/generate-social-promotions.mjs && vite build && node scripts/prerender.mjs && node scripts/indexnow.mjs",
    "build:sitemap": "node scripts/build-sitemap.mjs",
    "generate-social": "node scripts/generate-social-promotions.mjs",
    "submit:index": "node scripts/build-sitemap.mjs && node scripts/indexnow.mjs",
    "indexnow": "node scripts/build-sitemap.mjs && node scripts/indexnow.mjs",
    "generate-icons": "node scripts/generate-icons.mjs",
    "lint": "tsc --noEmit",
    "preview": "vite preview --port 3000 --host 0.0.0.0"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql-formatter": "^15.4.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
