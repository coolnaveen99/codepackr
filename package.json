{
  "name": "codepackr",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "node scripts/generate-icons.mjs && node scripts/build-sitemap.mjs && node scripts/generate-metadata.mjs && node scripts/generate-social-promotions.mjs && vite build && node scripts/prerender.mjs && node scripts/indexnow.mjs",
    "build:sitemap": "node scripts/build-sitemap.mjs",
    "generate-social": "node scripts/generate-social-promotions.mjs",
    "submit:index": "node scripts/build-sitemap.mjs && node scripts/indexnow.mjs",
    "indexnow": "node scripts/build-sitemap.mjs && node scripts/indexnow.mjs",
    "generate-icons": "node scripts/generate-icons.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --port 3000 --host 0.0.0.0"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@types/diff": "^8.0.0",
    "@uiw/react-codemirror": "^4.25.11",
    "diff": "^9.0.0",
    "firebase": "^12.18.0",
    "html2canvas": "^1.4.1",
    "js-yaml": "^4.1.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql-formatter": "^15.4.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.63.1",
    "@rollup/rollup-linux-x64-gnu": "^4.63.1"
  }
}
