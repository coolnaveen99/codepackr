{
  "standard": "EDIFACT",
  "version": "D96A",
  "description": "UN/EDIFACT Directory D.96A Standard Message Dictionary",
  "segments": {
    "UNB": {
      "tag": "UNB",
      "name": "Interchange Header",
      "purpose": "To start, identify and specify an interchange.",
      "elements": [
        { "pos": "01", "name": "Syntax Identifier (UNOA/UNOB/UNOC)", "type": "C", "min": 4, "max": 4, "req": "M" },
        { "pos": "02", "name": "Interchange Sender Identification", "type": "C", "min": 1, "max": 35, "req": "M" },
        { "pos": "03", "name": "Interchange Recipient Identification", "type": "C", "min": 1, "max": 35, "req": "M" },
        { "pos": "04", "name": "Date / Time of Preparation (YYMMDD:HHMM)", "type": "C", "min": 1, "max": 14, "req": "M" },
        { "pos": "05", "name": "Interchange Control Reference", "type": "AN", "min": 1, "max": 14, "req": "M" },
        { "pos": "06", "name": "Recipient Reference / Password", "type": "C", "min": 1, "max": 14, "req": "O" },
        { "pos": "07", "name": "Application Reference", "type": "AN", "min": 1, "max": 14, "req": "O" }
      ]
    },
    "UNH": {
      "tag": "UNH",
      "name": "Message Header",
      "purpose": "To head, identify and specify a message (e.g. ORDERS, INVOIC, DESADV).",
      "elements": [
        { "pos": "01", "name": "Message Reference Number", "type": "AN", "min": 1, "max": 14, "req": "M" },
        { "pos": "02", "name": "Message Identifier (Type, Version, Release, Agency)", "type": "C", "min": 1, "max": 20, "req": "M" },
        { "pos": "03", "name": "Common Access Reference", "type": "AN", "min": 1, "max": 35, "req": "O" }
      ]
    },
    "BGM": {
      "tag": "BGM",
      "name": "Beginning of Message",
      "purpose": "To indicate the type and function of a message and transmit identifying number.",
      "elements": [
        { "pos": "01", "name": "Document / Message Name (220=Order, 380=Invoice)", "type": "C", "min": 1, "max": 3, "req": "C" },
        { "pos": "02", "name": "Document / Message Number", "type": "AN", "min": 1, "max": 35, "req": "C" },
        { "pos": "03", "name": "Message Function Code (9=Original, 7=Duplicate)", "type": "ID", "min": 1, "max": 3, "req": "O" }
      ]
    },
    "DTM": {
      "tag": "DTM",
      "name": "Date / Time / Period",
      "purpose": "To specify date, and/or time, or period (137=Document Date, 2=Delivery Date).",
      "elements": [
        { "pos": "01", "name": "Date / Time / Period (Qualifier, Value, Format Code)", "type": "C", "min": 1, "max": 35, "req": "M" }
      ]
    },
    "NAD": {
      "tag": "NAD",
      "name": "Name and Address",
      "purpose": "To specify the name/address and their related function (BY=Buyer, SU=Supplier, DP=Delivery Party).",
      "elements": [
        { "pos": "01", "name": "Party Qualifier (BY/SU/DP/IV)", "type": "ID", "min": 1, "max": 3, "req": "M" },
        { "pos": "02", "name": "Party Identification Details (GLN / EAN)", "type": "C", "min": 1, "max": 35, "req": "C" },
        { "pos": "03", "name": "Name and Address Line", "type": "C", "min": 1, "max": 70, "req": "O" },
        { "pos": "04", "name": "Party Name", "type": "C", "min": 1, "max": 35, "req": "O" },
        { "pos": "05", "name": "Street and Number / P.O. Box", "type": "C", "min": 1, "max": 35, "req": "O" },
        { "pos": "06", "name": "City Name", "type": "AN", "min": 1, "max": 35, "req": "O" },
        { "pos": "08", "name": "Postal Identification Code", "type": "AN", "min": 1, "max": 9, "req": "O" },
        { "pos": "09", "name": "Country Name Code", "type": "ID", "min": 2, "max": 3, "req": "O" }
      ]
    },
    "LIN": {
      "tag": "LIN",
      "name": "Line Item",
      "purpose": "To identify a line item and its product numbers (GTIN / Article).",
      "elements": [
        { "pos": "01", "name": "Line Item Number", "type": "N", "min": 1, "max": 6, "req": "O" },
        { "pos": "02", "name": "Action Request / Notification", "type": "ID", "min": 1, "max": 3, "req": "O" },
        { "pos": "03", "name": "Item Number Identification (GTIN:EN)", "type": "C", "min": 1, "max": 35, "req": "C" }
      ]
    },
    "QTY": {
      "tag": "QTY",
      "name": "Quantity",
      "purpose": "To specify a pertinent quantity (21=Ordered Quantity, 12=Despatch Quantity).",
      "elements": [
        { "pos": "01", "name": "Quantity Details (Qualifier, Quantity, Unit)", "type": "C", "min": 1, "max": 15, "req": "M" }
      ]
    },
    "MOA": {
      "tag": "MOA",
      "name": "Monetary Amount",
      "purpose": "To specify a monetary amount (e.g. 77=Invoice Total, 203=Line Amount, 125=Taxable Amount).",
      "elements": [
        { "pos": "01", "name": "Monetary Amount (Qualifier, Amount, Currency)", "type": "C", "min": 1, "max": 35, "req": "M" }
      ]
    },
    "UNT": {
      "tag": "UNT",
      "name": "Message Trailer",
      "purpose": "To end and check the completeness of a message.",
      "elements": [
        { "pos": "01", "name": "Number of Segments in a Message", "type": "N", "min": 1, "max": 6, "req": "M" },
        { "pos": "02", "name": "Message Reference Number", "type": "AN", "min": 1, "max": 14, "req": "M" }
      ]
    },
    "UNZ": {
      "tag": "UNZ",
      "name": "Interchange Trailer",
      "purpose": "To end and check the completeness of an interchange.",
      "elements": [
        { "pos": "01", "name": "Interchange Control Count", "type": "N", "min": 1, "max": 6, "req": "M" },
        { "pos": "02", "name": "Interchange Control Reference", "type": "AN", "min": 1, "max": 14, "req": "M" }
      ]
    }
  }
}
